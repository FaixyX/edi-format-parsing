# Database Configuration
# Required: PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
# For production with SSL: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=postgresql://user:password@localhost:5432/your_database

# Security
# Required: Secret key for JWT tokens and encryption
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-this-in-production

# Admin Credentials (optional, defaults shown)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=password

# Redis Configuration
# Option 1: Use REDIS_URL (recommended for production)
# REDIS_URL=redis://:password@host:port/db
# Option 2: Use individual settings (for local development)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SSL=false

# Encryption Key (optional, for PHI encryption)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=

# Google OAuth (optional, for Google Sheets integration)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=

# Application URLs
BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Worker Configuration (optional)
WORKER_SERVICE_URL=http://localhost:8001
WORKER_THREADS=10
WORKER_PORT=8081
WORKER_SHUTDOWN_TIMEOUT=60
DRAMATIQ_WORKER_TIMEOUT=30000

# Playwright Configuration (optional)
PLAYWRIGHT_HEADLESS=True
PLAYWRIGHT_LAUNCH_TIMEOUT=120000
PLAYWRIGHT_LAUNCH_MAX_RETRIES=3

# Decodo Proxy (optional, for proxy support)
HOST=isp.decodo.com
proxy_PORT=10001
USERNAME=
PASSWORD=

# Fly.io Configuration (for production deployment)
FLY_APP_NAME=
FLY_API_TOKEN=
FLY_KMS_PATH=/var/secrets

# KMS Configuration (for encryption key management)
KMS_MODE=
DEV_KMS_FALLBACK_KEY=

# Autoscaler Configuration (optional)
AUTOSCALER_ENABLED=false
AUTOSCALER_INTERVAL=60
AUTOSCALER_MAX_MACHINES=5
AUTOSCALER_MIN_MACHINES=0

# Logging
LOG_LEVEL=INFO
